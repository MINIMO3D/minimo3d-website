{
  "name": "minimo3d-website",
  "version": "1.0.0",
  "description": "MINIMO3D Website (Payload CMS + Next.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/jetbrains-mono": "^5",
    "@fontsource-variable/space-grotesk": "^5",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "fflate": "^0.8.3",
    "graphql": "^16.8.1",
    "next": "16.4.1",
    "occt-import-js": "^0.0.23",
    "payload": "3.93.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "stripe": "^23.1.0",
    "three": "^0.172.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.172.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "private": true
}
